.PHONY: help start stop build test lint migrate seed shell

help: ## Show help
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' Makefile | sort | awk 'BEGIN {FS = ":.*?## "}; {printf "🔧 %-20s %s\n", $$1, $$2}'

start: ## Start services
	docker compose up -d

stop: ## Stop services
	docker compose down

build: ## Build all services
	docker compose build

lint: ## Run all linters
	pre-commit run --all-files

test: ## Run tests with coverage
	docker exec parcellab-backend-challenge-backend-api-1 pytest app/tests

migrate: ## 📦 Autogenerate Alembic migration only if schema changes exist
	@echo "\n🔍 Checking for model changes..."
	@tmpfile=$$(mktemp); \
	alembic revision --autogenerate -m "autogenerated" > "$$tmpfile"; \
	filename=$$(grep -o 'alembic/versions/.*\.py' "$$tmpfile"); \
	if [ -z "$$filename" ]; then \
		echo "❌ Alembic did not generate a file."; \
		rm "$$tmpfile"; \
		exit 1; \
	fi; \
	if grep -q 'pass' "$$filename"; then \
		echo "🛑 No schema changes detected. Deleting $$filename..."; \
		rm "$$filename"; \
	else \
		read -p "📝 Changes detected. Enter a name for the migration: " name; \
		newfile=$$(echo "$$filename" | sed "s/_autogenerated/_$${name// /_}/"); \
		mv "$$filename" "$$newfile"; \
		echo "✅ Migration created: $$newfile"; \
	fi; \
	rm "$$tmpfile"

seed: ## Seed the database
	docker exec -it parcellab-backend-challenge-backend-api-1 python -m app.scripts.seed

shell: ## Open backend container shell
	docker exec -it parcellab-backend-challenge-backend-api-1 bash
